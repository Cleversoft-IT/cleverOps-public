# Header di Cloudflare Pages (copiato così com'è nell'export statico).
# Gli asset di Next in _next/static hanno l'hash nel nome: si possono tenere in cache per sempre.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Tutto self-hosted: script e stili inline servono al tema senza flash e al payload di Next.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Il dominio canonico è cleverops.cleversoft.it: la copia su pages.dev non va indicizzata.
https://cleverops.pages.dev/*
  X-Robots-Tag: noindex
