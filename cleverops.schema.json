{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cleversoft-IT/cleverOps-public/cleverops.schema.json",
  "title": "cleverOps source manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "visibility", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "visibility": { "enum": ["public", "private"] },
    "skills": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9-]{1,64}$" },
      "additionalProperties": { "$ref": "#/$defs/skill" }
    },
    "agents": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9-]{1,64}$" },
      "additionalProperties": { "$ref": "#/$defs/agent" }
    }
  },
  "$defs": {
    "targets": {
      "type": "array",
      "items": { "enum": ["claude", "codex"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "skill": {
      "type": "object",
      "required": ["category"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "targets": { "$ref": "#/$defs/targets" },
        "legacy": { "type": "boolean" },
        "replaces": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "uniqueItems": true
        },
        "requires": {
          "type": "object",
          "properties": { "path": { "type": "string" } }
        }
      }
    },
    "agent": {
      "type": "object",
      "required": ["category"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "targets": { "$ref": "#/$defs/targets" }
      }
    }
  }
}
